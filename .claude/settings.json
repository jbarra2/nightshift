      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "PowerShell(git commit *--no-veri*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git *core.hooksPath*)",
