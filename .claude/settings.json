    "ask": [
      "Read(/private/**)",
      "Edit(/private/**)",
      "Edit(/.claude/**)",
      "Edit(/.githooks/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.gitignore)",
      "Edit(/.gitattributes)",
      "Bash(ssh *)",
      "Bash(scp *)",
