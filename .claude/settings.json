      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git commit *--no-veri*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git *core.hooksPath*)",
      "Bash(git *core.hookspath*)",
      "Bash(git switch main)",
      "Bash(git switch main *)",
      "Bash(git switch * main)",
      "Bash(git checkout main)",
      "Bash(git checkout main *)",
      "Bash(git checkout * main)",
      "Bash(git branch * main)",
      "Bash(git branch * main *)",
      "Bash(git update-ref *refs/heads/main*)",
      "Bash(git add -f*)",
      "Bash(git add * -f*)",
      "Bash(git add *--force*)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(gh auth *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push*)",
      "PowerShell(git -c * push*)",
      "PowerShell(git send-pack *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
