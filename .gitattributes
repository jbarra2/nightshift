# Store text with LF line endings, so Windows checkouts match the server and CI.
* text=auto eol=lf

# Shell scripts and the git hooks must stay LF: Git for Windows' sh can't run
# a script with CRLF line endings.
*.sh text eol=lf
.githooks/* text eol=lf

# Binary files: README and deck screenshots, PDFs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
